  <h2 data-i18n-html="article.installation.text13" set:html={t("en", "article.installation.text13")} />
  <p data-i18n-html="article.installation.text14" set:html={t("en", "article.installation.text14")} />
  <pre><code>public class ExamplePlugin extends JavaPlugin &#123;
    public MineCoreApi api;

    @Override
    public void onEnable() &#123;
        api = new MineCoreApi();
        StoreListeners listeners = new StoreListeners(api, this);
        api.getAsyncEventBus().register(listeners);
    &#125;
&#125;</code></pre>

  <h2 data-i18n-html="article.installation.text15" set:html={t("en", "article.installation.text15")} />
  <p data-i18n-html="article.installation.text16" set:html={t("en", "article.installation.text16")} />
  <pre><code>StoreProduct product = StoreProduct.builder()
    .name("Example Product")
    .id("example_product")
    .price(1)
    .quantity(1)
    .build();

StoreRequest request = StoreRequest.builder()
    .storeProducts(new StoreProduct[] &#123;product&#125;)
    .mcaccount(player.getUniqueId())
    .build();

plugin.api.getMinecoreRequestManager().createRequest(request);</code></pre>

  <h2 data-i18n-html="article.installation.text17" set:html={t("en", "article.installation.text17")} />
  <p data-i18n-html="article.installation.text18" set:html={t("en", "article.installation.text18")} />
  <pre><code>ServerPayRequest payRequest = ServerPayRequest.builder()
    .mcaccount(player.getUniqueId().toString())
    .amount(10.0)
    .build();

ServerPayResponse response =
    plugin.api.getMinecoreRequestManager().createServerPay(payRequest);

if (response != null) &#123;
    plugin.getLogger().info("Serverbetaling oprettet");
&#125;</code></pre>
  <p data-i18n-html="article.installation.text19" set:html={t("en", "article.installation.text19")} />
  <pre><code>ServerPayRequest payRequest = ServerPayRequest.builder()
    .mcaccount("player-uuid")
