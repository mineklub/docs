JsonObject json = payRequest.toJson();</code></pre>
  <p data-i18n-html="article.installation.text20" set:html={t("en", "article.installation.text20")} />

    <h2 data-i18n-html="article.installation.text21" set:html={t("en", "article.installation.text21")} />
    <p data-i18n-html="article.installation.text22" set:html={t("en", "article.installation.text22")} />
    <pre><code>GetVotesOptions options = GetVotesOptions.builder()
    .mcaccount(player.getUniqueId().toString())
    .page(1)
    .limit(25)
    .withMeta(true)
    .build();

  GetVotesResponse response =
    plugin.api.getMinecoreRequestManager().getVotes(options);

  if (response != null && response.getAll() != null) &#123;
    for (MappedVote vote : response.getAll()) &#123;
      plugin.getLogger().info("Vote: " + vote.getId());
    &#125;
  &#125;</code></pre>
    <p data-i18n-html="article.installation.text23" set:html={t("en", "article.installation.text23")} />
    <pre><code>MappedVote vote = event.getVote();

  if (vote != null && processVote(vote)) &#123;
    plugin.api.getMinecoreRequestManager().acceptVote(vote);
  &#125; else if (vote != null) &#123;
    plugin.api.getMinecoreRequestManager().rejectVote(vote);
  &#125;</code></pre>

    <h2 data-i18n-html="article.installation.text24" set:html={t("en", "article.installation.text24")} />
  <p data-i18n-html="article.installation.text25" set:html={t("en", "article.installation.text25")} />
  <pre><code>@Subscribe
public void receiveEvent(ReceiveRequestEvent event) &#123;
    StoreCreatedRequest request = event.getStoreRequest();
    if (request == null) &#123;
        return;
    &#125;

    processRequest(request);
    mineCoreApi.getMinecoreRequestManager().acceptRequest(request);
&#125;

@Subscribe
public void receiveVoteEvent(ReceiveVoteEvent event) &#123;
    MappedVote vote = event.getVote();
    processVote(vote);
    mineCoreApi.getMinecoreRequestManager().acceptVote(vote);
&#125;</code></pre>
