<script>
  document.querySelectorAll<HTMLElement>('[data-connection-tabs]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (selected: HTMLButtonElement) => {
      tabs.forEach((tab) => {
        const active = tab === selected;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#${tab.getAttribute('aria-controls')}`)!;
        panel.hidden = !active;
        panel.setAttribute('role', 'tabpanel');
        panel.tabIndex = 0;
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        let next: number;
        switch (event.key) {
          case 'ArrowRight': next = (index + 1) % tabs.length; break;
          case 'ArrowLeft': next = (index + tabs.length - 1) % tabs.length; break;
          case 'Home': next = 0; break;
          case 'End': next = tabs.length - 1; break;
          default: return;
        }
        event.preventDefault();
        select(tabs[next]);
        tabs[next].focus();
      });
    });
    select(tabs[0]);
    list.hidden = false;
    const revealHashTarget = () => {
      const target = document.getElementById(window.location.hash.slice(1));
      if (!target) return;
      const matchingTab = tabs.find((tab) => {
        const panel = document.getElementById(tab.getAttribute('aria-controls')!);
        return panel?.contains(target);
      });
      if (matchingTab) {
        select(matchingTab);
        target.scrollIntoView();
      }
    };
    revealHashTarget();
    window.addEventListener('hashchange', revealHashTarget);
  });
</script>

<style>
  .connection-tab-list:not([hidden]) { display: flex; flex-wrap: wrap; gap: 8px; border-bottom: 1px solid var(--line); padding-bottom: 10px; }
  .connection-tab-list button { font: inherit; font-weight: 600; padding: 10px 16px; border: 1px solid var(--line); border-radius: 9px; background: var(--surface); color: var(--muted); cursor: pointer; }
  .connection-tab-list button[aria-selected='true'] { color: var(--text); border-color: var(--accent); background: var(--surface-2); box-shadow: inset 0 -3px var(--accent); }
  .connection-tab-list button:hover { color: var(--text); }
  .connection-tab-list button:focus-visible, [role='tabpanel']:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
</style>
