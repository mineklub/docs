---
import { t } from '../../i18n';
import DocsLayout from '../../layouts/DocsLayout.astro';
import '../../styles/global.css';
---
<DocsLayout titleKey="article.skript.title" eyebrowKey="article.skript.eyebrow">
  <p class="lead" data-i18n-html="article.skript.text01" set:html={t("en", "article.skript.text01")} />
  <h2 data-i18n-html="article.skript.text02" set:html={t("en", "article.skript.text02")} />
  <pre><code>create a minecore request for player:
    add product "my-product" named "My Product" price 10
    add product "premium" named "Premium" price 20 quantity 1</code></pre>
  <h2 data-i18n-html="article.skript.text03" set:html={t("en", "article.skript.text03")} />
  <pre><code>on minecore receive request:
    log "Received: %event-type%"
    accept minecore request event-request

on minecore receive vote:
    accept minecore vote event-vote</code></pre>
  <h2 data-i18n-html="article.skript.text04" set:html={t("en", "article.skript.text04")} />
  <p data-i18n-html="article.skript.text05" set:html={t("en", "article.skript.text05")} />
</DocsLayout>
