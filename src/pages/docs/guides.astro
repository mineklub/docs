---
import { t } from '../../i18n';
import DocsLayout from '../../layouts/DocsLayout.astro';
import '../../styles/global.css';
---
<DocsLayout titleKey="article.guides.title" eyebrowKey="article.guides.eyebrow">
  <p class="lead" data-i18n-html="article.guides.text01" set:html={t("en", "article.guides.text01")} />
  <h2 data-i18n-html="article.guides.text02" set:html={t("en", "article.guides.text02")} />
  <p class="lead" data-i18n-html="article.guides.text03" set:html={t("en", "article.guides.text03")} />

  <h2 data-i18n-html="article.guides.text04" set:html={t("en", "article.guides.text04")} />
  <div class="event-flow" data-i18n-aria-label="a11y.events" aria-label={t("en", "a11y.events")}>
    <div class="event-step"><span>01</span><strong>PreCreateRequestEvent</strong><small data-i18n-html="article.guides.text05" set:html={t("en", "article.guides.text05")} /></div>
    <div class="flow-arrow">→</div>
    <div class="event-step"><span>02</span><strong>PostCreateRequestEvent</strong><small data-i18n-html="article.guides.text06" set:html={t("en", "article.guides.text06")} /></div>
    <div class="flow-arrow">→</div>
    <div class="event-step"><span>03</span><strong>ReceiveRequestEvent</strong><small data-i18n-html="article.guides.text07" set:html={t("en", "article.guides.text07")} /></div>
  </div>
  <div class="event-flow single"><div class="event-step"><span>VOTE</span><strong>ReceiveVoteEvent</strong><small data-i18n-html="article.guides.text08" set:html={t("en", "article.guides.text08")} /></div></div>

  <h2 data-i18n-html="article.guides.text09" set:html={t("en", "article.guides.text09")} />
  <p data-i18n-html="article.guides.text10" set:html={t("en", "article.guides.text10")} />
  <pre><code>public void onPreCreate(PreCreateRequestEvent event) &#123;
    StoreRequest request = event.getStoreRequest();

    if (!isAllowed(request)) &#123;
        event.setCancelled(true);
    &#125;
&#125;</code></pre>
  <p data-i18n-html="article.guides.text11" set:html={t("en", "article.guides.text11")} />

  <h2 data-i18n-html="article.guides.text12" set:html={t("en", "article.guides.text12")} />
  <p data-i18n-html="article.guides.text13" set:html={t("en", "article.guides.text13")} />
  <pre><code>public void onPostCreate(PostCreateRequestEvent event) &#123;
    StoreCreatedRequest request = event.getStoreRequest();
    saveRequestId(request.getId());
&#125;</code></pre>

  <h2 data-i18n-html="article.guides.text14" set:html={t("en", "article.guides.text14")} />
  <p data-i18n-html="article.guides.text15" set:html={t("en", "article.guides.text15")} />
  <pre><code>public void onReceiveRequest(ReceiveRequestEvent event) &#123;
    StoreCreatedRequest request = event.getStoreRequest();

    if ("purchase".equals(event.getType()) && isValid(request)) &#123;
        giveProducts(request);
        MineCoreApi.getInstance()
            .getMinecoreRequestManager()
            .acceptRequest(request);
    &#125;
&#125;</code></pre>
  <p data-i18n-html="article.guides.text16" set:html={t("en", "article.guides.text16")} />

  <h2 data-i18n-html="article.guides.text17" set:html={t("en", "article.guides.text17")} />
  <p data-i18n-html="article.guides.text18" set:html={t("en", "article.guides.text18")} />
  <div class="event-flow skript-flow" data-i18n-aria-label="a11y.skriptEvents" aria-label={t("en", "a11y.skriptEvents")}>
    <div class="event-step"><span>01</span><strong>pre create request</strong><small data-i18n-html="article.guides.text19" set:html={t("en", "article.guides.text19")} /></div>
    <div class="flow-arrow">→</div>
    <div class="event-step"><span>02</span><strong>post create request</strong><small data-i18n-html="article.guides.text20" set:html={t("en", "article.guides.text20")} /></div>
    <div class="flow-arrow">→</div>
    <div class="event-step"><span>03</span><strong>receive request</strong><small data-i18n-html="article.guides.text21" set:html={t("en", "article.guides.text21")} /></div>
  </div>
  <div class="event-flow single skript-vote-flow"><div class="event-step"><span>VOTE</span><strong>receive vote</strong><small data-i18n-html="article.guides.text22" set:html={t("en", "article.guides.text22")} /></div></div>
  <h3 data-i18n-html="article.guides.text23" set:html={t("en", "article.guides.text23")} />
  <pre><code>create a minecore request for player:
    add product "my-product" named "My Product" price 10
    add product "premium" named "Premium" price 20 quantity 1</code></pre>
  <h3 data-i18n-html="article.guides.text24" set:html={t("en", "article.guides.text24")} />
  <p data-i18n-html="article.guides.text25" set:html={t("en", "article.guides.text25")} />
  <pre><code>on minecore pre create request:
    if &lt;din validering fejler&gt;:
        cancel event
        log "MineCore request blev stoppet"</code></pre>
  <h3 data-i18n-html="article.guides.text26" set:html={t("en", "article.guides.text26")} />
  <pre><code>on minecore post create request:
    log "MineCore request blev oprettet"
    log "Request: %event-request%"</code></pre>
  <h3 data-i18n-html="article.guides.text27" set:html={t("en", "article.guides.text27")} />
  <pre><code>on minecore receive request:
    log "Modtog request: %event-type%"
    accept minecore request event-request

on minecore receive vote:
    log "Modtog vote"
    accept minecore vote event-vote</code></pre>
  <p data-i18n-html="article.guides.text28" set:html={t("en", "article.guides.text28")} />

  <h2 data-i18n-html="article.guides.text29" set:html={t("en", "article.guides.text29")} />
  <p data-i18n-html="article.guides.text30" set:html={t("en", "article.guides.text30")} />
  <pre><code>public void onReceiveVote(ReceiveVoteEvent event) &#123;
    MappedVote vote = event.getVote();

    if (alreadyProcessed(vote)) &#123;
        return;
    &#125;

    giveVoteReward(vote);
    markAsProcessed(vote);
    MineCoreApi.getInstance()
        .getMinecoreRequestManager()
        .acceptVote(vote);
&#125;</code></pre>

  <h2 data-i18n-html="article.guides.text31" set:html={t("en", "article.guides.text31")} />
  <p data-i18n-html="article.guides.text32" set:html={t("en", "article.guides.text32")} />
  <p data-i18n-html="article.guides.text33" set:html={t("en", "article.guides.text33")} />
  </DocsLayout>
<style is:global>
  .event-flow { display: flex; align-items: stretch; gap: 10px; margin: 28px 0 12px; }.event-flow.single { width: 235px; }.event-step { display: grid; flex: 1; min-width: 0; padding: 16px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }.event-step span { color: var(--accent); font: .68rem 'DM Mono', monospace; }.event-step strong { margin-top: 18px; color: var(--text); font-size: .88rem; line-height: 1.2; overflow-wrap: anywhere; }.event-step small { margin-top: 8px; color: var(--muted); font-size: .72rem; line-height: 1.35; }.flow-arrow { display: grid; place-items: center; color: var(--warm); font-size: 1.2rem; }
  @media (max-width: 760px) { .event-flow { display: grid; grid-template-columns: 1fr; }.event-flow.single { width: 100%; }.flow-arrow { transform: rotate(90deg); } }
</style>
