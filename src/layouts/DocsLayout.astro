---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const {title, description, eyebrow = 'Dokumentation'} = Astro.props;
const sections = [
  {label: 'Kom i gang', href: '/docs/kom-i-gang'},
  {label: 'Java API-installation', href: '/docs/installation'},
  {label: 'Livscyklus', href: '/docs/lifecycle'},
  {label: 'API-reference', href: '/docs/api'},
  {label: 'Skript-hooks', href: '/docs/skript'},
  {label: 'Fejlfinding', href: '/docs/fejlfinding'},
];
---
<BaseLayout title={title} description={description}>
  <div class="docs-shell">
    <aside class="docs-sidebar">
      <p class="sidebar-label">MineCore</p>
      <nav aria-label="Dokumentation">
        {sections.map((section) => <a class:list={{active: Astro.url.pathname === section.href}} href={section.href}>{section.label}</a>)}
      </nav>
    </aside>
    <article class="doc-content">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <slot />
    </article>
  </div>
</BaseLayout>
