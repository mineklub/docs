---
import { t, type MessageKey } from '../i18n';
import BaseLayout from './BaseLayout.astro';

interface Props {
  titleKey: MessageKey;
  descriptionKey?: MessageKey;
  eyebrowKey?: MessageKey;
}

const {titleKey, descriptionKey, eyebrowKey = 'nav.docs'} = Astro.props;
const sections: { key: MessageKey; href: string; children?: { key: MessageKey; href: string }[] }[] = [
  {key: 'nav.start', href: '/docs/kom-i-gang'},
  {key: 'nav.external', href: '/docs/eksterne-servere', children: [
    {key: 'nav.setup', href: '/docs/serveropsaetning'},
  ]},
  {key: 'nav.installation', href: '/docs/installation'},
  {key: 'nav.lifecycle', href: '/docs/lifecycle'},
  {key: 'nav.api', href: '/docs/api'},
  {key: 'nav.skript', href: '/docs/skript'},
  {key: 'nav.troubleshooting', href: '/docs/fejlfinding'},
];
---
<BaseLayout titleKey={titleKey} descriptionKey={descriptionKey}>
  <div class="docs-shell">
    <aside class="docs-sidebar">
      <p class="sidebar-label">MineCore</p>
      <nav data-i18n-aria-label="nav.docs" aria-label={t("en", "nav.docs")}>
        {sections.map((section) => section.children ? (
          <div class="sidebar-group">
            <a class:list={{active: Astro.url.pathname === section.href}} href={section.href} data-i18n-html={section.key}>{t("en", section.key)}</a>
            <ul class="sidebar-children" data-i18n-aria-label={section.key} aria-label={t("en", section.key)}>
              {section.children.map((child) => (
                <li><a class:list={{active: Astro.url.pathname === child.href}} aria-current={Astro.url.pathname === child.href ? 'page' : undefined} href={child.href} data-i18n-html={child.key}>{t("en", child.key)}</a></li>
              ))}
            </ul>
          </div>
        ) : <a class:list={{active: Astro.url.pathname === section.href}} href={section.href} data-i18n-html={section.key}>{t("en", section.key)}</a>)}
      </nav>
    </aside>
    <article class="doc-content">
      <p class="eyebrow" data-i18n-html={eyebrowKey}>{t("en", eyebrowKey)}</p>
      <h1 data-i18n-html={titleKey}>{t("en", titleKey)}</h1>
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  .sidebar-group { min-width: 0; }
  .sidebar-group > a, .sidebar-children a { display: block; }
  .sidebar-children { list-style: none; margin: 5px 0 0 12px; padding: 0 0 0 6px; border-left: 1px solid var(--line); }
  .sidebar-children a { font-size: .9rem; }
</style>
