{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "warn"
  },
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "dist/**",
    "build/**",
    "coverage/**",
    ".next/**",
    ".astro/**",
    ".wrangler/**",
    ".vinext/**",
    ".agents/**"
  ]
}
